# Django settings
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=["ww.printoften.co.uk", "localhost"]
DJANGO_CSRF_TRUSTED_ORIGINS=["https://ww.printoften.co.uk"]
DJANGO_DB_ENGINE=django.db.backends.sqlite3
DJANGO_DB_NAME=db.sqlite3
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=
DJANGO_DB_PORT=
DJANGO_STATIC_ROOT=
DJANGO_STATIC_URL=/static/
DJANGO_TIME_ZONE=Europe/London
DJANGO_SESSION_HOURS=8

# Google Sheets integration
GOOGLE_SHEETS_CREDENTIALS_FILE=/path/to/service-account.json
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET_NAME=General Orders

# Toggle audit logging (true/false)
ENABLE_AUDIT_LOGGING=true
